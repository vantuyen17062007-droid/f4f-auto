<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_floating"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/card_floating_content"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Tiêu đề + trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="F4F"
                android:src="@drawable/ic_f_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bvp_bold"
                    android:text="F4F Auto Runner"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dot_floating_indicator"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/status_ok" />

                    <TextView
                        android:id="@+id/tv_floating_status_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Đang chạy • 0h 0m"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_floating_minimize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Thu gọn"
                android:padding="7dp"
                android:src="@drawable/ic_minus"
                android:tint="@color/text_sub" />

            <ImageView
                android:id="@+id/btn_floating_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng bảng nổi"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_sub" />
        </LinearLayout>

        <!-- Nền tảng, tài khoản, job đang chạy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_floating_platform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_platform"
                    android:fontFamily="@font/bvp_bold"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="TikTok"
                    android:textColor="@color/on_coin"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_floating_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/bvp_semibold"
                    android:singleLine="true"
                    android:text="\@nick_dang_chay"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_floating_job_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Đang quét job..."
                android:textColor="@color/text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/hairline" />

        <!-- Số xu + kết quả -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_floating_coins"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/bvp_extrabold"
                android:text="+0 xu"
                android:textColor="@color/coin"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_floating_success"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bvp_semibold"
                    android:text="0 Thành công"
                    android:textColor="@color/status_ok"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_floating_failed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/bvp_semibold"
                    android:text="0 Thất bại"
                    android:textColor="@color/status_error"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 nút điều khiển -->
        <LinearLayout
            android:id="@+id/box_floating_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_floating_resume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_ctrl_primary"
                    android:contentDescription="Tiếp tục"
                    android:padding="13dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/on_coin" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tiếp tục"
                    android:textColor="@color/text_sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_floating_pause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_ctrl_neutral"
                    android:contentDescription="Tạm dừng"
                    android:padding="13dp"
                    android:src="@drawable/ic_pause"
                    android:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tạm dừng"
                    android:textColor="@color/text_sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_floating_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_ctrl_danger"
                    android:contentDescription="Dừng"
                    android:padding="13dp"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/on_coin" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dừng"
                    android:textColor="@color/text_sub"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Tay nắm để kéo -->
    <View
        android:id="@+id/drag_handle_pill"
        android:layout_width="72dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_floating_handle" />
</LinearLayout>
